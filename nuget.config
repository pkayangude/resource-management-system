<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Redirect NuGet global packages to a short path to avoid MAX_PATH issues -->
    <!-- This machine's workspace is on OneDrive with a very long base path -->
    <add key="globalPackagesFolder" value="C:\NuPkgs" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
